# Copy this file to .env and fill in real values. Never commit .env itself.

ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated list of allowed CORS origins. Leave unset for
# local dev (falls back to FRONTEND_URL above); set in production to the
# deployed frontend domain(s).
CORS_ALLOWED_ORIGINS=

# --- Supabase (create a project at https://supabase.com) ---
# New key system: Settings -> API Keys tab (not "Legacy API Keys")
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# --- Claude (Anthropic API key) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Embeddings (OpenAI) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_data

# --- Reviewed-ticket history (SQLite) ---
TICKETS_DB_PATH=./data/tickets.db

# --- Jira OAuth 2.0 (register app at https://developer.atlassian.com/console/myapps/) ---
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:8000/jira/callback
JIRA_SCOPES=read:jira-work write:jira-work offline_access

# --- Coaching loop tuning ---
MAX_CLARIFICATION_ROUNDS=5
READINESS_PASS_THRESHOLD=2
